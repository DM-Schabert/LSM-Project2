module load pandas/2.3.0-python-3.12.11
module load matplotlib/3.10.3-numpy-2.3.1-python-3.12.11
module load mpi4py/4.0.3-python-3.12.11-openmpi-5.0.8
export OMP_NUM_THREADS=1 MPLBACKEND=Agg PYTHONUNBUFFERED=1
BASE="--data gaia_subsets/gaia_clusters_C1_n100.csv --steps 10000 --tile-rows 0 --time-limit 60"
for P in 24 16 8; do mpirun -np $P python3 IO_Improvements/exchange_bench.py; done
for P in 24 20 16 8; do
  echo "===== $P ranks, merging on";  mpirun -np $P python3 IO_Improvements/ClusterImplementation.py $BASE --merge-radius 0.001
  echo "===== $P ranks, merging off"; mpirun -np $P python3 IO_Improvements/ClusterImplementation.py $BASE --merge-radius 0 --stop-check-every 100
done

