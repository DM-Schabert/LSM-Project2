#!/usr/bin/env bash
#BSUB -J dtype_smoke
#BSUB -q hpc
#BSUB -n 4
#BSUB -R "span[hosts=1]"
#BSUB -W 00:10
#BSUB -R "rusage[mem=1GB]"
#BSUB -oo logs/smoke_%J.out
#BSUB -eo logs/smoke_%J.err
set -euo pipefail
# Submit from INSIDE data_types/: bsub < jobs/smoke.lsf
cd "${LS_SUBCWD:-$PWD}"
source ./hpc_env.sh
mkdir -p results
job="${LSB_JOBID:-manual}"
# Tests non-divisible N/P and ranks receiving zero stars.
mpirun -np 1 python3 -u benchmark_allgatherv.py --n 3 --iterations 5 --repeats 1 --output "results/smoke_${job}.csv"
mpirun -np 2 python3 -u benchmark_allgatherv.py --n 7 --iterations 5 --repeats 1 --output "results/smoke_${job}.csv"
mpirun -np 4 python3 -u benchmark_allgatherv.py --n 2 --iterations 5 --repeats 1 --output "results/smoke_${job}.csv"
mpirun -np 4 python3 -u benchmark_allgatherv.py --n 7 --iterations 5 --repeats 1 --output "results/smoke_${job}.csv"
echo 'SMOKE TEST PASSED: All methods matched expected coordinates.'
