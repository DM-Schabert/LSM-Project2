# LSBATCH: User input

#!/usr/bin/env bash
#BSUB -J small_n
#BSUB -q hpc
#BSUB -n 8
#BSUB -R "span[hosts=1]"
#BSUB -W 00:30
#BSUB -R "rusage[mem=1GB]"
#BSUB -oo logs/small_n_%J.out
#BSUB -eo logs/small_n_%J.err

set -euo pipefail
cd "${LS_SUBCWD:-$PWD}"
source ./config.sh

for N in 50 100; do
    for P in 2 4 8; do
        for R in 1 2; do
            echo "Running N=$N P=$P repeat=$R"

            mpirun -np "$P" python3 ../ParallelImplementation.py \
                --data "../gaia_subsets/gaia_random_${N}.csv" \
                --steps 10000 \
                --dt 0.01 \
                --softening 0.01 \
                --merge-radius 0 \
                --no-results \
                > "logs/N${N}_P${P}_long_R${R}.log" 2>&1
        done
    done
done

