  echo "===== $P ranks, no merge check";        mpirun -np $P python3 IO_Improvements/ClusterImplementation.py $BASE --merge-radius 0
  echo "===== $P ranks, both";                  mpirun -np $P python3 IO_Improvements/ClusterImplementation.py $BASE --merge-radius 0 --stop-check-every 100
done

